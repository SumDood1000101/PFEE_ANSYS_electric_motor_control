{text%node Integral (epsilon: float32; windup: bool)
        returns (integral: float32)
      {
        let integral = (0.0 -> pre integral) + (if windup then 0.0 else T_CYCLE * epsilon);
      }%text}

{text%node Derivative (epsilon: float32)
        returns (derivative: float32)
      {
        let derivative = ( epsilon - (epsilon -> pre epsilon) ) / T_CYCLE;
      }%text}

const T_CYCLE: float32 = 0.01;

const M_PERIOD: int32 = 100;
